const SHEET_NAME = 'Orders';
const SPREADSHEET_ID = '1vFyERjcp02kqyxLi4GNxpLftu8WXHXpuy1m_y3wVIrM';
function getOrdersSpreadsheet(){const ss=SPREADSHEET_ID?SpreadsheetApp.openById(SPREADSHEET_ID):SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw new Error('No spreadsheet found. Check SPREADSHEET_ID and sharing access.');return ss;}
function json(value){return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);}
function saveOrder(payload){const ss=getOrdersSpreadsheet(),sheet=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME),headers=['Received at','Order ID','Name','Phone','Email','Address','City','State','Pincode','Selected payment method','Payment status','Total paid now (INR)','Original total (INR)','Discount (INR)','Paid now (INR)','Balance due (INR)','Items'];if(sheet.getLastRow()===0)sheet.appendRow(headers);const orderId=payload.orderId||'';if(orderId&&sheet.getLastRow()>1&&sheet.getRange(2,2,sheet.getLastRow()-1,1).getValues().flat().includes(orderId))return{ok:true,duplicate:true};const items=Array.isArray(payload.items)?payload.items:[],itemText=items.map(item=>`${item.title} | ${item.model} | ${item.colour} | qty ${item.quantity} | ₹${item.unitPrice}`).join(' ; ');sheet.appendRow([new Date(),orderId,payload.customer?.name||'',payload.customer?.phone||'',payload.customer?.email||'',payload.customer?.address||'',payload.customer?.city||'',payload.customer?.state||'',payload.customer?.pincode||'',payload.selectedPaymentMethod||payload.paymentMethod||'Prepaid',payload.paymentStatus||'Payment initiated',Number(payload.total||payload.amountPaidNow||0),Number(payload.originalTotal||0),Number(payload.discount||0),Number(payload.amountPaidNow||payload.total||0),Number(payload.balanceOnDelivery||0),itemText]);return{ok:true};}
function doGet(e){try{let raw=(e&&e.parameter&&e.parameter.payload)||'';if(!raw&&e&&e.queryString)raw=e.queryString;if(raw.indexOf('payload=')===0)raw=raw.slice(8);try{raw=decodeURIComponent(raw);}catch(ignore){}return raw?json(saveOrder(JSON.parse(raw))):json({ok:true,service:'Coverly order capture'});}catch(error){return json({ok:false,error:String(error)});}}
function doPost(e){try{let raw=(e&&e.postData&&e.postData.contents)||'';if(raw.indexOf('payload=')===0)raw=raw.slice(8);if(!raw&&e&&e.parameter)raw=e.parameter.payload||'';try{raw=decodeURIComponent(raw);}catch(ignore){}return json(saveOrder(raw?JSON.parse(raw):{}));}catch(error){return json({ok:false,error:String(error)});}}
